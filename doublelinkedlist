#include <iostream>
using namespace std;

class node
{
public:
    int data;
    node *next;
    node*prev;

    node(int x)
    {
        data = x;
        next = NULL;
        prev = NULL;
    }
};

class linkedlist
{
private:
    node *head;

public:
    linkedlist()
    {
        head = NULL;
    }

    void insert(int x)
    {
        node *p, *q;
        p = new node(x);

        if (head == NULL)
        {
            head = p;
        }
        else
        {
            q = head;

            while (q->next != NULL)
            {
                q = q->next;
            }

            q->next = p;
            p->prev = q;
        }
    }

    void display()
    {
        node *q;
        q = head;

        while (q != NULL)
        {
            cout << q->data << " ";
            q = q->next;
        }

        cout << endl;
    }

    void remove(int x)
    {
        node *p = NULL;
        {
            if(head->data==x)
            {
                p=head;
                head=head->next;
                head->prev=NULL;
                delete p;
            }
            
        node *q=head;
        while(q!=NULL)
        while(q->next!= NULL)
        {
            if(q->next->data==x)
            {
                p=q->next;
                q->next=p->next;
                p->next->prev=q;
                delete p;
                return;
            }
        q=q->next;

        }
        }
        }
};

int main()
{
    linkedlist list;
    list.insert(10);
    list.insert(20);
    list.insert(30);
    list.insert(40);
    list.display();
    list.remove(30);
    list.display();

    return 0;
}
